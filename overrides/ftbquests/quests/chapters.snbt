	// original chapter-arc skeleton and can be deleted safely.
	id: "compact_exploitation"
	title: "Folded Horizons"
	icon: "gtceu:steel_machine_casing"
	description: [
		"You wake up inside a sealed cell. No ores. No sky. No crafting table."
		"The walls themselves feed you — mine them without breaking them."
		"Work your way out through GregTech and AE2, then open temporary"
		"dimensions and strip them bare."
	]
